# ── Server ────────────────────────────────────────────────────
PORT=3000
# Long random secret; the console asks for it once per device
ADMIN_TOKEN=change-me-to-a-long-random-string
DB_PATH=./data/hiring.db

# ── AI ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5
# The hiring assistant's first name (its own persona, not the sales assistant)
ASSISTANT_NAME=Jordan
TIMEZONE=America/Chicago

# ── Company ───────────────────────────────────────────────────
COMPANY_NAME=Astro Ford
COMPANY_ADDRESS=
CONTACT_EMAIL=

# ── Hiring manager (alerts + default interviewer) ─────────────
MANAGER_NAME=
MANAGER_PHONE=

# ── Twilio: a DEDICATED hiring number with its own A2P 10DLC campaign ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VALIDATE_SIGNATURE=true

# ── Alerts (optional; names/phones are stripped before posting) ──
DISCORD_WEBHOOK_URL=
# Public base URL of this app, for the console link in Discord alerts
PUBLIC_URL=

# ── Job defaults (the console's Setup tab overrides these) ────
# Your IdealTraits (or other) application link
APPLY_URL=
JOB_ROLE=Sales Consultant
INTERVIEW_HOURS=Monday-Friday, 9 AM to 5 PM

# Minutes the assistant stays quiet after the manager texts an applicant
COPILOT_COOLDOWN_MIN=12
